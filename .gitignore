__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime data — never commit market data, caches or run artifacts.
#
# Anchored with a leading slash so these match only the directories at the repository
# root. Unanchored, `data/` also matches `src/swingbot/data/` at any depth — which
# silently excluded the entire data layer, ten modules, from every commit. The push
# succeeded, the working tree ran fine, and a fresh clone could not import swingbot at
# all. Keep the slashes.
/data/
/runs/
*.parquet
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.duckdb
!tests/fixtures/**/*.parquet

# Scratch data directories from side-by-side fetches. The real cache is /data/.
/data-real/
/data-india-real/
